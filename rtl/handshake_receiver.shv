module handshake_receiver(
    input logic valid,
    output logic rready
);
    logic in_ready;
    enum logic {IDLE_H,WAIT2READY,WAIT2VALID,TRANSFER} current_fsm, next_fsm;

    always_ff@(posedge clock, negedge nreset)begin
        if(!nreset)begin
            current_fsm <=IDLE_H;
            in_ready <= 1;
        end else begin
            current_fsm <= next_fsm;
            in_ready    <= current_fsm == WAIT2VALID;
        end
    end
    always_comb case(current_fsm)
        IDLE_H:begin
            case({valid,in_ready})
                2'b00:next_fsm = IDLE_H;
                2'b10:next_fsm = WAIT2READY;
                2'b01:next_fsm = WAIT2VALID;
                2'b11:next_fsm = TRANSFER;
            endcase
        end
        WAIT2VALID:begin
            next_fsm = (valid&in_ready) ? TRANSFER: current_fsm;
        end
        WAIT2READY:begin
            next_fsm = (valid&in_ready) ? TRANSFER: current_fsm;
        end
        TRANSFER:begin
            case({valid,in_ready})
                2'b00:next_fsm = IDLE_H;
                2'b10:next_fsm = WAIT2READY;
                2'b01:next_fsm = WAIT2VALID;
                2'b11:next_fsm = TRANSFER;
            endcase
        end        
    endcase
    assign rready = in_ready;
endmodule