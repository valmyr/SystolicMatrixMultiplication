module handshake_transmitter(
    input logic r_ready,
    output logic r_valid
);
    logic in_valid;
    enum logic {IDLE_H,WAIT2READY,WAIT2VALID,TRANSFER} current_fsm, next_fsm;

    always_ff@(posedge clock, negedge nreset)begin
        if(!nreset)begin
            current_fsm <=IDLE_H;
            in_valid <= 0;
        end else begin
            current_fsm <= next_fsm;
            in_valid <= current_fsm == WAIT2READY;
        end
    end
    always_comb case(current_fsm)
        IDLE_H:begin
            case({in_valid,r_ready})
                2'b00:next_fsm = IDLE_H;
                2'b10:next_fsm = WAIT2READY;
                2'b01:next_fsm = WAIT2VALID;
                2'b11:next_fsm = TRANSFER;
            endcase
        end
        WAIT2VALID:begin
            next_fsm = (in_valid&r_ready) ? TRANSFER: current_fsm;
        end
        WAIT2READY:begin
            next_fsm = (in_valid&r_ready) ? TRANSFER: current_fsm;
        end
        TRANSFER:begin
            case({in_valid,r_ready})
                2'b00:next_fsm = IDLE_H;
                2'b10:next_fsm = WAIT2READY;
                2'b01:next_fsm = WAIT2VALID;
                2'b11:next_fsm = TRANSFER;
            endcase
        end        
    endcase
    assign r_valid = in_valid;
endmodule