# Location of BUFG Primitives 
set_property LOC BUFGCTRL_X0Y16 [get_cells led_OBUF_BUFG_inst]
set_property LOC BUFGCTRL_X0Y1 [get_cells dbg_hub/inst/BSCANID.u_xsdbm_id/SWITCH_N_EXT_BSCAN.u_bufg_icon_tck]
set_property LOC BUFGCTRL_X0Y0 [get_cells SystolicCore0/uart_systolic_core/uart_transmitter/in0_BUFG_inst]
set_property LOC BUFGCTRL_X0Y2 [get_cells SystolicCore0/uart_systolic_core/uart_receiver/rx_data_valid_BUFG_inst]
set_property LOC BUFGCTRL_X0Y6 [get_cells SystolicCore0/serial2mem_opB/n_1_6_BUFG_inst]
set_property LOC BUFGCTRL_X0Y4 [get_cells SystolicCore0/serial2mem_opB/clock_inter_BUFG_inst]
set_property LOC BUFGCTRL_X0Y5 [get_cells SystolicCore0/serial2mem_opA/n_0_6_BUFG_inst]
set_property LOC BUFGCTRL_X0Y3 [get_cells SystolicCore0/serial2mem_opA/clock_inter_BUFG_inst]

# Location of IO Primitives which is load of clock spine
set_property LOC IOB_X1Y101 [get_cells led_OBUF_inst]

# Location of clock ports
set_property LOC IOB_X1Y126 [get_ports clock]

# Clock net "led_OBUF_BUFG" driven by instance "led_OBUF_BUFG_inst" located at site "BUFGCTRL_X0Y16"
#startgroup
create_pblock {CLKAG_led_OBUF_BUFG}
add_cells_to_pblock [get_pblocks  {CLKAG_led_OBUF_BUFG}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL && NAME!=led_OBUF_inst} -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="led_OBUF_BUFG"}]]]
resize_pblock [get_pblocks {CLKAG_led_OBUF_BUFG}] -add {CLOCKREGION_X0Y0:CLOCKREGION_X0Y0 CLOCKREGION_X0Y1:CLOCKREGION_X0Y1 CLOCKREGION_X0Y2:CLOCKREGION_X0Y2 CLOCKREGION_X1Y0:CLOCKREGION_X1Y0 CLOCKREGION_X1Y1:CLOCKREGION_X1Y1 CLOCKREGION_X1Y2:CLOCKREGION_X1Y2}
#endgroup

